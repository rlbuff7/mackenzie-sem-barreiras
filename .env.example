# Modelo de configuração. Copie para .env e preencha:
#   cp .env.example .env
# O .env NÃO vai para o Git. Este arquivo vai, sem valores reais.

# --- Banco (PostgreSQL 16 + PostGIS 3.4) ---
POSTGRES_DB=mackenzie_sem_barreiras
POSTGRES_USER=msb
POSTGRES_PASSWORD=troque-esta-senha
# Porta no host. 5432/5433 costumam estar ocupadas por outros projetos.
POSTGRES_PORTA_HOST=5434
# Host visto pelo backend (fora do container, em dev): o compose já mapeia a
# porta do banco em 127.0.0.1.
POSTGRES_HOST=localhost

# --- Backend (API FastAPI, M2) ---
# Porta do uvicorn no host.
API_PORTA_HOST=8000
# Origens liberadas no CORS, separadas por vírgula. Só o servidor de dev do
# Vite (`npm run dev`, porta 5173) precisa: ele fala com a API por uma porta
# diferente (cross-origin de verdade). O frontend em container NÃO entra
# aqui — `frontend/nginx.conf` encaminha `/api/` para o serviço `api` na
# MESMA origem do frontend (R19), então o navegador nunca faz uma requisição
# cross-origin para a API em produção/coleta.
CORS_ORIGENS=http://localhost:5173
# Token exigido no header X-Token-Admin de POST /validacao/executar (D7).
# Vazio = sem proteção — só em desenvolvimento.
TOKEN_ADMIN=
# Documentação interativa da API (/docs, /redoc, /openapi.json). `true` em
# desenvolvimento. Na coleta pública, ponha `false`: as três rotas passam a
# responder 404 e o esquema da API não fica à mostra. Aceita true/false sem
# diferenciar maiúsculas; a API precisa reiniciar para ler o novo valor.
EXPOR_DOCS=true
# Tamanho máximo do corpo de POST /alertas, em bytes (16 KiB). Acima disso a API
# responde 413 sem gravar nada; o nginx do frontend aplica o mesmo limite antes
# (`client_max_body_size` em frontend/nginx.conf: mantenha os dois iguais).
LIMITE_CORPO_BYTES=16384

# --- Frontend (nginx + build estático, M5) ---
# Porta do nginx no host. 8080, o "óbvio", costuma já estar ocupada por outro
# serviço na máquina de quem desenvolve (Jenkins, Tomcat, etc.) — daí 8081.
FRONTEND_PORTA_HOST=8081

# --- Validação (usados a partir do M3) ---
# Valores PROVISÓRIOS, a calibrar com a orientadora. Ver docs/decisoes-pendentes.md.
DBSCAN_EPS_METROS=8
DBSCAN_MIN_POINTS=2
MIN_CONFIRMACOES=3
SRID_ARMAZENAMENTO=4326
SRID_CALCULO=31983

# --- Roteamento (CLAUDE.md §6) ---
# Fatores multiplicados pelo comprimento da aresta para formar o custo.
# Valores PROVISÓRIOS, a calibrar com a orientadora (pendência 5).
PENALIDADE_ESCADA=4.0
PENALIDADE_TRAVESSIA=2.0
PENALIDADE_TRECHO_NAO_VERIFICADO=1.5
# Perfil cegueira: multiplica o custo de escada, travessia e trecho nao conferido
# a pe (PROVISORIO, a validar com a orientadora).
PENALIDADE_PERFIL_VISUAL=2.0
# Perfil baixa_visao: mesma regra de custo da cegueira, com penalidade propria (PROVISORIO,
# a validar com a orientadora).
PENALIDADE_PERFIL_BAIXA_VISAO=1.5
# Máximo de pontos de interesse devolvidos por GET /pontos-interesse.
LIMITE_PONTOS_INTERESSE_POR_CONSULTA=500

# --- Orientação ao vivo (M4), distâncias em metros ---
# Valores PROVISÓRIOS, a calibrar com a medição de GPS e com a orientadora (pendência #1).
# Precisão do celular pior que isto: a API não dá nenhuma orientação (silêncio).
PRECISAO_MINIMA_METROS=15
# Desvio da rota acima disto, mais a precisão informada, vira "fora da rota".
DISTANCIA_FORA_DA_ROTA_METROS=15
# Distância restante pela rota abaixo disto vira "chegou".
RAIO_CHEGADA_METROS=10

# Rumo e mensagens (M4), PROVISORIOS, a calibrar com a orientadora.
# Direcao: alvo = ponto da rota tantos metros a frente da posicao.
ALVO_A_FRENTE_METROS=8
# Velocidade media do deslocamento (da trilha) abaixo disto = parado: nenhuma direcao.
VELOCIDADE_PARADO_MS=0.3
# Oscilacao da bussola acima disto (graus) = instavel: parado, sem direcao.
RUMO_OSCILACAO_MAXIMA_GRAUS=30
# Rumo HIBRIDO: andando pelo MOVIMENTO, parado pela bussola (decisao de 03/11/2026, a validar com a orientadora), PROVISORIOS:
# deslocamento minimo (m) entre um ponto da trilha e a posicao atual; abaixo disto, sem rumo.
DESLOCAMENTO_MINIMO_RUMO_METROS=8
# Janela da trilha (s): pontos mais antigos que isto sao ignorados.
JANELA_TRILHA_SEGUNDOS=15
# Setores: frente = ate 30 graus para cada lado; atras = acima de 150; lados = entre os dois.
SETOR_FRENTE_GRAUS=30
SETOR_ATRAS_GRAUS=150
# Mesma mensagem nao se repete antes disto (s); perigo repete em intervalo menor.
INTERVALO_REPETICAO_SEGUNDOS=20
INTERVALO_REPETICAO_PERIGO_SEGUNDOS=8
# Escada/travessia a menos disto (m) a frente: aviso de perigo.
DISTANCIA_PERIGO_METROS=15
# Curva a menos disto (m) a frente: "Em N metros, vire ...".
DISTANCIA_CURVA_IMINENTE_METROS=10

# --- Medição de GPS em tempo real (/medicao.html) ---
# Código que a equipe digita no celular (header X-Codigo-Equipe do POST /medicoes).
# Vazio = medição DESLIGADA no servidor (a API responde 503). Em produção, defina um
# valor longo e aleatório só no .env do servidor; nunca versione o valor real.
MEDICAO_CODIGO_EQUIPE=
