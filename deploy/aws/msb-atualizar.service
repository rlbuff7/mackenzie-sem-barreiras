[Unit]
Description=Atualiza o protótipo do TCC se há imagens novas no GHCR (pull)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=@USUARIO@
WorkingDirectory=@REPO@
Environment=DIR_REPO=@REPO@
ExecStart=/bin/bash @REPO@/deploy/aws/atualizar-se-mudou.sh
TimeoutStartSec=900
